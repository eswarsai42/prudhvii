# --- EmailJS (Wedding Time Capsule). Values come from your EmailJS dashboard. ---
# These three are public by design (EmailJS public key); the recipient address is fixed inside the EmailJS template.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=

# --- Supabase (only for the public guestbook wall; server-side only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=

# --- Public, non-secret settings ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Path or URL of the soundtrack, e.g. /audio/wedding-theme.mp3 (file placed in /public/audio).
# Empty = a soft generated ambient pad is used instead.
NEXT_PUBLIC_MUSIC_URL=
